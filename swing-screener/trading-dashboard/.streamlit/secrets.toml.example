# Copy to .streamlit/secrets.toml for local runs. On Streamlit Cloud paste this into
# App settings → Secrets. NEVER commit the real secrets.toml.

# Alpaca (free "Basic" market-data plan). Leave out to use Yahoo data.
ALPACA_API_KEY = ""
ALPACA_SECRET_KEY = ""

# Finnhub (free) — earnings calendar now; news + analyst changes in phase 2
FINNHUB_API_KEY = ""

# Google Sheets log: the ID is the long string in the sheet URL between /d/ and /edit
SHEET_ID = ""

# Optional overrides of core/settings.py
[settings]
top_n = 10
earnings_window_days = 7
atr_stop_mult = 1.5

# Google service-account JSON, field by field (share the sheet with client_email as Editor)
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
